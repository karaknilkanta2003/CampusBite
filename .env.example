# Copy to .env and fill in. Everything has a safe development default.

# --- Core ---
NODE_ENV=development
PORT=8080
# Public URL people open (used in emails and push links)
PUBLIC_URL=http://localhost:8080
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production
DATABASE_PATH=./data/campusbite.db
# Load demo canteens, menus and staff accounts on first start (development only)
SEED_DEMO=true

# --- Who can sign in ---
# Comma-separated email domains allowed to sign in
ALLOWED_EMAIL_DOMAINS=iiit.ac.in,students.iiit.ac.in,research.iiit.ac.in
# These emails become admins on first sign-in
ADMIN_EMAILS=

# --- Email (sign-in codes). Leave SMTP_HOST empty to print codes in the server log ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CampusBite <no-reply@example.edu>"

# --- Payments: mock | razorpay ---
# mock marks orders paid with no money taken. Production refuses it unless ALLOW_MOCK_PAYMENTS=true
# (useful for a free pilot where the fee is waived).
PAYMENT_PROVIDER=mock
ALLOW_MOCK_PAYMENTS=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Convenience fee per order, in rupees
ORDER_FEE_RUPEES=5

# --- Campus map ---
# Tile server for the map. OpenStreetMap's servers are fine for light use; use a provider for production.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors
# Where the map opens: "lat,lon" and zoom level
MAP_CENTER=17.4463,78.3480
MAP_ZOOM=17

# --- Push notifications (order ready alerts). Generate with: npm run vapid --workspace server ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.edu
